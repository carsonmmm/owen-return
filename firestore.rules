rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isHost() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /rsvps/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'name', 'status', 'party', 'meal', 'message', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 200
        && request.resource.data.status in ['in', 'maybe', 'no']
        && request.resource.data.party is number
        && request.resource.data.party >= 0
        && request.resource.data.party <= 6;
      allow delete: if signedIn() && (request.auth.uid == uid || isHost());
    }

    match /event/{eventId} {
      allow read: if signedIn();
      allow create, update, delete: if isHost() && eventId == 'main';
    }

    // Admin documents must be created manually in the Firebase Console.
    // No client-side user can grant themselves host access.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}